# IA Studio — platform-api
# Copie para .env e ajuste os valores.

# PostgreSQL (banco unico iastudio_db)
DATABASE_URL="postgresql://iastudio:iastudio@localhost:5432/iastudio_db?schema=public"

# JWT — obrigatorio em producao (minimo 32 chars). Gere com: openssl rand -hex 32
JWT_SECRET="troque-este-segredo-por-um-de-32-chars-ou-mais"

# Chave de criptografia AES-256-GCM (base do Secrets Manager) — minimo 32 chars em producao
ENCRYPTION_KEY="troque-esta-chave-por-uma-de-32-chars-ou-mais"

# HTTP
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Seed inicial (so roda quando o banco nao tem nenhum usuario)
PLATFORM_ADMIN_EMAIL=admin@iastudio.local
PLATFORM_ADMIN_PASSWORD=admin123

# OAuth2 do Google (Email Platform — Gmail). Crie as credenciais em
# console.cloud.google.com → APIs & Services → Credentials (OAuth Client ID,
# tipo "Web application"). O redirect DEVE bater exatamente com a rota publica
# do callback (sem /v1): https://SEU_DOMINIO/api/integrations/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT="http://localhost:3000/api/integrations/oauth/google/callback"

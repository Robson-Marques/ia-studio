# IA Studio — platform-api
# Copie para .env e ajuste os valores.

# PostgreSQL exclusivo da aplicação (substitua <app-id>)
DATABASE_URL="postgresql://iastudio_app:troque@localhost:5432/iastudio_app?schema=public"

# JWT — obrigatorio em producao (minimo 32 chars). Gere com: openssl rand -hex 32
JWT_SECRET="troque-este-segredo-por-um-de-32-chars-ou-mais"

# Chave de criptografia AES-256-GCM (base do Secrets Manager) — minimo 32 chars em producao
ENCRYPTION_KEY="troque-esta-chave-por-uma-de-32-chars-ou-mais"

# HTTP
PORT=3000
CORS_ORIGINS=http://localhost:5173

# WAHA local. Em instalação/upgrade no servidor estes valores são gerados e o
# container Docker é provisionado automaticamente; não aparecem no painel.
IASTUDIO_WAHA_PORT=3400
IASTUDIO_WAHA_URL="http://127.0.0.1:3400"
IASTUDIO_WAHA_API_KEY=""
IASTUDIO_WAHA_WEBHOOK_URL="http://host.docker.internal:3000/api/webhooks/whatsapp/waha"
IASTUDIO_WAHA_IMAGE="devlikeapro/waha:latest-2026.10.1"

# Seed inicial local (só roda quando o banco não tem usuários)
INSTALLATION_ADMIN_EMAIL=admin@iastudio.local
INSTALLATION_ADMIN_PASSWORD=troque-esta-senha

# OAuth2 do Google (Email Platform — Gmail). Crie as credenciais em
# console.cloud.google.com → APIs & Services → Credentials (OAuth Client ID,
# tipo "Web application"). O redirect DEVE bater exatamente com a rota publica
# do callback (sem /v1): https://SEU_DOMINIO/api/integrations/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT="http://localhost:3000/api/integrations/oauth/google/callback"

{
  "name": "platform-api",
  "version": "0.1.0",
  "description": "IA Studio — API de uma instalação dedicada (monólito modular NestJS + Fastify + Prisma)",
  "private": true,
  "scripts": {
    "postinstall": "node ../scripts/waha-container.js --optional --install-docker",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "test:newnet:documents": "node --require ts-node/register --test src/modules/ai/connectchat/subscriber-document.spec.ts",
    "test:newnet:billing": "node --require ts-node/register --test src/modules/ai/connectchat/billing-response.spec.ts",
    "test:newnet:technical-case": "node --require ts-node/register --test src/modules/ai/connectchat/technical-case-reasoning.spec.ts",
    "test:newnet:history": "node --require ts-node/register --test src/modules/ai/connectchat/technical-history-analysis.spec.ts",
    "test:newnet:planner": "node --require ts-node/register --test src/modules/ai/connectchat/technical-case-planner.spec.ts",
    "test:newnet:dialogue": "node --require ts-node/register --test src/modules/ai/connectchat/technical-conversation-state.spec.ts",
    "test:newnet:acceptance": "node --require ts-node/register --test src/modules/ai/connectchat/technical-support-acceptance.spec.ts",
    "test:newnet": "node --require ts-node/register --test src/modules/ai/connectchat/subscriber-document.spec.ts src/modules/ai/connectchat/billing-response.spec.ts src/modules/ai/connectchat/technical-history-analysis.spec.ts src/modules/ai/connectchat/technical-case-reasoning.spec.ts src/modules/ai/connectchat/technical-case-planner.spec.ts src/modules/ai/connectchat/technical-conversation-state.spec.ts src/modules/ai/connectchat/technical-support-acceptance.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^2.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/mapped-types": "^2.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-fastify": "^10.0.0",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/throttler": "^5.1.5",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.0",
    "@prisma/client": "^5.0.0",
    "bullmq": "^5.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.9.14",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.15",
    "@types/passport-jwt": "^4.0.0",
    "@types/uuid": "^9.0.0",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  }
}
